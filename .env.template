# Build-time environment template.
#
# Values live in the deployment platform, not in the repository. Copy this file to
# `.env.local` only for local development.

# Branding, used by the PWA manifest, the page title and the metadata.
VITE_DEFAULT_NAME=Petersburg Bridge Test
VITE_DEFAULT_NAME_SHORT=Petersburg Bridge
VITE_DEFAULT_THEME_COLOR='#0b0f71'
VITE_DEFAULT_DESCRIPTION=Test task for Petersburg Bridge.

# Public base path the application is served from.
VITE_BASE_PATH=/

# How long cached query data stays fresh, in seconds.
VITE_QUERY_STALE_TIME=60000

# How long the build info file stays cached, in seconds.
VITE_BUILD_INFO_EXPIRATION_TIME=86400

# Dev server port and build output directory.
VITE_PORT=3000
VITE_OUTPUT_DIR=build

# One of prod | dev | test. Controls robots meta and service worker registration.
VITE_NODE_ENV=dev
